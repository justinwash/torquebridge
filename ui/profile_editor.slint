    preferred-width: 1500px;
    preferred-height: 940px;
    min-width: 1260px;
    min-height: 840px;
    title: "Torquebridge Profile Studio";
    background: #080b11;

    Rectangle {
        background: #080b11;

        HorizontalLayout {
            padding: 22px;
            spacing: 22px;

            Rectangle {
