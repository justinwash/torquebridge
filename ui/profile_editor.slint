    callback calibration_guide_next_requested();
    callback calibration_guide_apply_requested();
    callback auto_calibration_requested();
    callback run_calibration_sweep_requested();
    callback toggle_hot_reload_requested();
    callback toggle_close_to_taskbar_requested();
    callback install_vjoy_requested();
    callback open_vjoy_config_requested();
