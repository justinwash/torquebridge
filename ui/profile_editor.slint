import { ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";

component NavCard inherits Rectangle {
    in property <string> label;
    in property <string> tag;
    in property <bool> selected: false;
    callback pressed();

    height: 54px;
    border-radius: 18px;
    background: selected ? #182233 : #0f141d;
    border-color: selected ? #c8942d : #1b2332;
    border-width: 1px;

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 12px;
            background: selected ? #d39a2d : #141b27;

            Text {
                text: tag;
                color: selected ? #1a1305 : #8e98aa;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: label;
            color: selected ? #f9fbff : #8d96a8;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.pressed();
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback pressed();

    height: 48px;
    border-radius: 18px;
    background: !enabled ? #272d37 : (primary ? #d39a2d : #171e2b);
    border-color: primary ? #d39a2d : #232c3c;
    border-width: primary ? 0px : 1px;

    Text {
        text: label;
        color: primary ? #1a1305 : #e3e8f2;
        font-size: 15px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.pressed();
        }
    }
}

component SegmentButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback pressed();

    height: 42px;
    border-radius: 16px;
    background: selected ? #d39a2d : #111722;
    border-color: selected ? #d39a2d : #1d2533;
    border-width: 1px;

    Text {
        text: label;
        color: selected ? #1a1305 : #d7ddea;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.pressed();
        }
    }
}

component StatCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <bool> highlighted: false;

    min-width: 220px;
    min-height: 92px;
    border-radius: 22px;
    background: highlighted ? #171f2d : #111722;
    border-color: highlighted ? #d39a2d : #1c2432;
    border-width: 1px;

    VerticalLayout {
        padding: 16px;
        spacing: 6px;

        Text {
            text: title;
            color: #8994a9;
            font-size: 12px;
            font-weight: 700;
        }

        Text {
            text: value;
            color: highlighted ? #fff4d8 : #f5f8ff;
            font-size: 18px;
            font-weight: 800;
        }
    }
}

component ToggleCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> active: false;
    callback pressed();

    min-width: 320px;
    min-height: 168px;
    border-radius: 24px;
    background: #121925;
    border-color: active ? #d39a2d : #1d2533;
    border-width: 1px;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        Text {
            text: title;
            color: #f6f8fb;
            font-size: 17px;
            font-weight: 700;
        }

        Text {
            text: subtitle;
            color: #7f8aa0;
            font-size: 13px;
        }

        Rectangle {
            height: 1px;
            background: #1d2533;
        }

        HorizontalLayout {
            spacing: 12px;

            Text {
                text: active ? "Enabled" : "Disabled";
                color: active ? #fff4d8 : #dfe7f5;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle { }

            ActionButton {
                width: 116px;
                primary: active;
                label: active ? "Turn Off" : "Turn On";
                pressed => {
                    root.pressed();
                }
            }
        }
    }
}

component FieldCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in-out property <float> value: 0;
    pure function snap_and_clamp(v: float) -> float {
        return clamp(round(v * 100) / 100, root.minimum, root.maximum);
    }

    border-radius: 24px;
    background: #121925;
    border-color: #1d2533;
    border-width: 1px;
    min-height: 168px;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        Text {
            text: title;
            color: #f6f8fb;
            font-size: 17px;
            font-weight: 700;
        }

        Text {
            text: subtitle;
            color: #7f8aa0;
            font-size: 13px;
        }

        Slider {
            minimum: minimum;
            maximum: maximum;
            step: 0.01;
            value <=> root.value;
            changed => {
                root.value = root.snap_and_clamp(self.value);
            }
        }

        HorizontalLayout {
            spacing: 10px;

            ActionButton {
                width: 44px;
                label: "-";
                pressed => {
                    root.value = root.snap_and_clamp(root.value - root.step);
                }
            }

            Rectangle {
                border-radius: 14px;
                background: #0c1118;
                border-color: #1f2735;
                border-width: 1px;
                min-width: 96px;
                height: 42px;

                LineEdit {
                    text: root.value;
                    edited => {
                        if self.text.is-float() {
                            root.value = root.snap_and_clamp(self.text.to-float());
                        }
                    }
                    accepted => {
                        if self.text.is-float() {
                            root.value = root.snap_and_clamp(self.text.to-float());
                        }
                    }
                }
            }

            ActionButton {
                width: 44px;
                label: "+";
                pressed => {
                    root.value = root.snap_and_clamp(root.value + root.step);
                }
            }
        }
    }
}

export component ProfileEditorWindow inherits Window {
