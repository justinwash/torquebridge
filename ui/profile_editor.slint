                            }

                            StatCard {
                                title: "HOT RELOAD";
                                value: hot_reload_summary;
                                highlighted: true;
                            }

                            StatCard {
                                title: "PROFILE MODE";
                                value: bridge_running ? "Live session" : "Editor only";
                            }
