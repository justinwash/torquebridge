    in-out property <string> observability_source_label;
    in-out property <string> telemetry_status;
    in-out property <string> telemetry_uptime;
    in-out property <string> telemetry_packet_rate;
    in-out property <string> telemetry_command_rate;
    in-out property <string> telemetry_steering;
    in-out property <string> telemetry_peak_force;
    in-out property <string> telemetry_calibration_profile;
    in-out property <string> telemetry_calibration_gain;
    in-out property <string> telemetry_filter_coefficient;
    in-out property <string> telemetry_clamp_status;
