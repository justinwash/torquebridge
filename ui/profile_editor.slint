    in-out property <float> calibration_const_gain;
    in-out property <float> calibration_sine_gain;
    in-out property <float> calibration_spring_gain;
    in-out property <float> calibration_damper_gain;
    in-out property <float> calibration_steering_center_offset;
    in-out property <float> calibration_steering_range;
    in-out property <float> calibration_steering_curve;

