                }

                if root.current_section != 0 : Rectangle {
                    border-radius: 24px;
                    background: #0d131c;
                    border-color: #18202d;
                    border-width: 1px;
                    min-height: 74px;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Rectangle {
                            border-radius: 14px;
                            background: bridge_running ? #16301e : #151b24;
                            border-color: bridge_running ? #348452 : #232b39;
                            border-width: 1px;
                            min-width: 180px;

                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;

                                Text {
                                    text: "Status";
                                    color: #8d96a8;
                                    font-size: 12px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: bridge_status;
                                    color: bridge_running ? #d9ffe5 : #eef3ff;
                                    font-size: 13px;
                                    font-weight: 700;
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 14px;
                            background: #111722;
                            border-color: #1d2533;
                            border-width: 1px;

                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;

                                Text {
                                    text: "Poll";
                                    color: #8d96a8;
                                    font-size: 12px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: runtime_poll_summary;
                                    color: #eef3ff;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 14px;
                            background: #111722;
                            border-color: #1d2533;
                            border-width: 1px;

                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;

                                Text {
                                    text: "Hot reload";
                                    color: #8d96a8;
                                    font-size: 12px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: hot_reload_summary;
                                    color: #fff4d8;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 14px;
                            background: #111722;
                            border-color: #1d2533;
                            border-width: 1px;

                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;

                                Text {
                                    text: "Mode";
                                    color: #8d96a8;
                                    font-size: 12px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: bridge_running ? "Live" : "Editor";
                                    color: #eef3ff;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                            }
                        }

                        Rectangle { }
                    }
                }

                Rectangle {
                    border-radius: 28px;
                    background: #0d131c;
                    border-color: #18202d;
                    border-width: 1px;

                    ScrollView {
                        VerticalLayout {
                            padding: 22px;
                            spacing: 20px;

                            HorizontalLayout {
                                spacing: 12px;

                                SegmentButton {
                                    label: "Runtime";
                                    selected: root.current_section == 0;
                                    pressed => {
                                        root.current_section = 0;
                                    }
                                }

                                SegmentButton {
                                    label: "Constant";
                                    selected: root.current_section == 1;
                                    pressed => {
                                        root.current_section = 1;
                                    }
                                }

                                SegmentButton {
                                    label: "Periodic";
                                    selected: root.current_section == 2;
                                    pressed => {
                                        root.current_section = 2;
                                    }
                                }

                                SegmentButton {
                                    label: "Condition";
                                    selected: root.current_section == 3;
                                    pressed => {
                                        root.current_section = 3;
                                    }
                                }

                                SegmentButton {
                                    label: "Calibration";
                                    selected: root.current_section == 4;
                                    pressed => {
                                        root.current_section = 4;
                                    }
                                }

                                SegmentButton {
                                    label: "Settings";
                                    selected: root.current_section == 5;
                                    pressed => {
                                        root.current_section = 5;
                                    }
                                }

                                SegmentButton {
                                    label: "Diagnostics";
                                    selected: root.current_section == 6;
                                    pressed => {
                                        root.current_section = 6;
                                    }
                                }

                                SegmentButton {
                                    label: "Compare";
                                    selected: root.current_section == 7;
                                    pressed => {
                                        root.current_section = 7;
                                    }
                                }

                                SegmentButton {
                                    label: "Expirimental";
                                    selected: root.current_section == 8;
                                    pressed => {
                                        root.current_section = 8;
                                    }
                                }

                                SegmentButton {
                                    label: "Telemetry";
                                    selected: root.current_section == 9;
                                    pressed => {
                                        root.current_section = 9;
                                    }
                                }
                            }

                            if root.current_section == 0 : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 18px;

                                    Text {
                                        text: "Runtime Controls";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "Pick input, poll rate, and launch mode.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Poll Interval";
                                            subtitle: "Runtime loop cadence in milliseconds.";
                                            minimum: 1;
                                            maximum: 20;
                                            step: 1;
                                            value <=> root.poll_ms;
                                        }

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 168px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 12px;

                                                Text {
                                                    text: "Selected Device";
                                                    color: #f6f8fb;
                                                    font-size: 17px;
                                                    font-weight: 700;
                                                }

                                                Text {
                                                    text: "Choose by name, not raw WinMM id.";
                                                    color: #7f8aa0;
                                                    font-size: 13px;
                                                }

                                                ComboBox {
                                                    model: root.steering_device_options;
                                                    current-index: root.selected_steering_device_index < 0 ? 0 : root.selected_steering_device_index;
                                                    selected => {
                                                        root.select_steering_device_requested(self.current-index);
                                                    }
                                                }

                                                Text {
                                                    text: selected_steering_device_label;
                                                    color: #e1e7f4;
                                                    font-size: 14px;
                                                    font-weight: 700;
                                                }

                                                Text {
                                                    text: device_catalog_message;
                                                    color: #8d96a8;
                                                    font-size: 13px;
                                                    visible: device_catalog_message != "";
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 24px;
                                        background: #121925;
                                        border-color: #1d2533;
                                        border-width: 1px;
                                        min-height: 136px;

                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 10px;

                                            Text {
                                                text: "Routing And Preflight";
                                                color: #f6f8fb;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }

                                            LineEdit {
                                                text: runtime_routing_status;
                                                read-only: true;
                                            }

                                            LineEdit {
                                                text: runtime_routing_source;
                                                read-only: true;
                                            }

                                            LineEdit {
                                                text: runtime_preflight_status;
                                                read-only: true;
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;

                                                ActionButton {
                                                    width: 150px;
                                                    label: "Install vJoy";
                                                    pressed => {
                                                        root.install_vjoy_requested();
                                                    }
                                                }

                                                ActionButton {
                                                    width: 160px;
                                                    label: "Open vJoyConf";
                                                    pressed => {
                                                        root.open_vjoy_config_requested();
                                                    }
                                                }

                                                Text {
                                                    text: "Runs Windows package install if available.";
                                                    color: #7f8aa0;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }
                                            }

                                        }
                                    }

                                    Rectangle {
                                        border-radius: 24px;
                                        background: #121925;
                                        border-color: #1d2533;
                                        border-width: 1px;
                                        min-height: 170px;

                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 10px;

                                            Text {
                                                text: "Plug And Play";
                                                color: #f6f8fb;
                                                font-size: 12px;
                                                font-weight: 800;
                                            }

                                            Text {
                                                text: "No Setup Wizard Required";
                                                color: #f6f8fb;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: "Select steering input, save profile, and launch. Diagnostics and replay workflows stay optional in the Diagnostics section.";
                                                color: #d9e2f2;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.current_section == 1 : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 18px;

                                    Text {
                                        text: "Constant Force";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "These controls shape the heavy steering-load and impact-style forces. Start with magnitude and maximum force, then use the filter threshold only if center behavior still feels noisy.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Constant Magnitude";
                                            subtitle: "Overall scale applied to constant-force effects.";
                                            minimum: 0;
                                            maximum: 2;
                                            step: 0.05;
                                            value <=> root.const_magnitude;
                                        }

                                        FieldCard {
                                            title: "Constant Maximum";
                                            subtitle: "Cap for the strongest constant forces.";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.const_maximum_force;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Constant Minimum";
                                            subtitle: "Minimum force floor to keep lighter detail from disappearing.";
                                            minimum: 0;
                                            maximum: 0.25;
                                            step: 0.01;
                                            value <=> root.const_minimum_force;
                                        }

                                        FieldCard {
                                            title: "Filter Threshold";
                                            subtitle: "Threshold before steering-state filtering starts shaping the output.";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.const_filter_threshold;
                                        }
                                    }

                                    FieldCard {
                                        title: "Minimum Steering Coefficient";
                                        subtitle: "Lower bound for steering-state filtered constant forces.";
                                        minimum: 0;
                                        maximum: 1;
                                        step: 0.02;
                                        value <=> root.const_minimum_coefficient;
                                    }
                                }
                            }

                            if root.current_section == 2 : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 18px;

                                    Text {
                                        text: "Periodic And Vibration";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "This section covers road texture, rumble, engine vibration, and gear-shift buzz. Use it for texture and energy, not heavy steering authority.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Sine Magnitude";
                                            subtitle: "Overall amplitude of periodic vibration effects.";
                                            minimum: 0;
                                            maximum: 1.5;
                                            step: 0.05;
                                            value <=> root.sine_magnitude;
                                        }

                                        FieldCard {
                                            title: "Sine Frequency Scale";
                                            subtitle: "Global multiplier applied to periodic timing.";
                                            minimum: 0.25;
                                            maximum: 4;
                                            step: 0.05;
                                            value <=> root.sine_frequency;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Sine Maximum";
                                            subtitle: "Upper clamp for vibration amplitude.";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.sine_maximum_force;
                                        }

                                        FieldCard {
                                            title: "Sine Phase";
                                            subtitle: "Phase offset used when periodic effects are created.";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.sine_phase;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Engine Vibration Strength";
                                            subtitle: "Strength of the engine-vibration special case.";
                                            minimum: 0;
                                            maximum: 0.25;
                                            step: 0.01;
                                            value <=> root.engine_vibration_strength;
                                        }

                                        FieldCard {
                                            title: "Gear Shift Strength";
                                            subtitle: "Strength of the gear-shift vibration special case.";
                                            minimum: 0;
                                            maximum: 0.25;
                                            step: 0.01;
                                            value <=> root.gear_shift_strength;
                                        }
                                    }
                                }
                            }

                            if root.current_section == 3 : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 18px;

                                    Text {
                                        text: "Condition Forces";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "Spring and damper settings shape centering, resistance, and how the wheel settles. These values matter most once the steering-device input is correct.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Spring Coefficient";
                                            subtitle: "Centering strength applied to spring effects.";
                                            minimum: 0;
                                            maximum: 0.25;
                                            step: 0.01;
                                            value <=> root.spring_coefficient;
                                        }

                                        FieldCard {
                                            title: "Spring Saturation";
                                            subtitle: "Cap for spring saturation under heavy condition forces.";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.spring_saturation;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Damper Coefficient";
                                            subtitle: "Resistance scaling used for damper effects.";
                                            minimum: 0;
                                            maximum: 0.25;
                                            step: 0.01;
                                            value <=> root.damper_coefficient;
                                        }

                                        FieldCard {
                                            title: "Damper Saturation";
                                            subtitle: "Cap for damping saturation during heavy load transitions.";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.damper_saturation;
                                        }
                                    }
                                }
                            }

                            if root.current_section == 4 : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 18px;

                                    Text {
                                        text: "Calibration";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "Use calibration to match the wheel, not the game packet. Output gain sets overall authority, while center, range, and curve tune how steering-state filtering ramps away from center.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 168px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 12px;

                                                Text {
                                                    text: "Preset Baseline";
                                                    color: #f6f8fb;
                                                    font-size: 17px;
                                                    font-weight: 700;
                                                }

                                                ComboBox {
                                                    model: root.calibration_preset_options;
                                                    current-index: root.selected_calibration_preset_index < 0 ? 0 : root.selected_calibration_preset_index;
                                                    selected => {
                                                        root.apply_calibration_preset_requested(self.current-index);
                                                    }
                                                }

                                                Text {
                                                    text: "Current preset: " + calibration_preset_label;
                                                    color: #d9e2f2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }

                                                ActionButton {
                                                    width: 176px;
                                                    primary: true;
                                                    label: "Auto Calibrate";
                                                    pressed => {
                                                        root.auto_calibration_requested();
                                                    }
                                                }

                                                ActionButton {
                                                    width: 176px;
                                                    label: "Run Sweep (4s)";
                                                    pressed => {
                                                        root.run_calibration_sweep_requested();
                                                    }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 168px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 10px;

                                                Text {
                                                    text: calibration_workflow_step_label;
                                                    color: #d39a2d;
                                                    font-size: 12px;
                                                    font-weight: 800;
                                                }

                                                Text {
                                                    text: calibration_workflow_title;
                                                    color: #f6f8fb;
                                                    font-size: 17px;
                                                    font-weight: 700;
                                                }

                                                Text {
                                                    text: calibration_workflow_detail;
                                                    color: #d9e2f2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }

                                                HorizontalLayout {
                                                    spacing: 12px;

                                                    ActionButton {
                                                        width: 84px;
                                                        label: "Back";
                                                        pressed => {
                                                            root.calibration_guide_previous_requested();
                                                        }
                                                    }

                                                    ActionButton {
                                                        width: 84px;
                                                        label: "Next";
                                                        pressed => {
                                                            root.calibration_guide_next_requested();
                                                        }
                                                    }

                                                    Rectangle { }

                                                    ActionButton {
                                                        width: 156px;
                                                        primary: true;
                                                        label: "Apply Step Assist";
                                                        pressed => {
                                                            root.calibration_guide_apply_requested();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Output Gain";
                                            subtitle: "Global gain applied across translated constant, periodic, spring, and damper output.";
                                            minimum: 0;
                                            maximum: 2;
                                            step: 0.05;
                                            value <=> root.calibration_output_gain;
                                        }

                                        FieldCard {
                                            title: "Center Offset";
                                            subtitle: "Shift the steering-state center used by force shaping. Positive values move the effective center right.";
                                            minimum: -0.25;
                                            maximum: 0.25;
                                            step: 0.01;
                                            value <=> root.calibration_steering_center_offset;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Steering Range";
                                            subtitle: "How much travel it takes before steering-state filtering reaches full force away from center.";
                                            minimum: 0.25;
                                            maximum: 2;
                                            step: 0.05;
                                            value <=> root.calibration_steering_range;
                                        }

                                        FieldCard {
                                            title: "Steering Curve";
                                            subtitle: "Response curve for center-to-edge force shaping. Lower ramps harder early; higher stays softer near center.";
                                            minimum: 0.25;
                                            maximum: 3;
                                            step: 0.05;
                                            value <=> root.calibration_steering_curve;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Constant Gain";
                                            subtitle: "Per-effect multiplier for constant-force translation after output gain.";
                                            minimum: 0;
                                            maximum: 2;
                                            step: 0.05;
                                            value <=> root.calibration_const_gain;
                                        }

                                        FieldCard {
                                            title: "Periodic Gain";
                                            subtitle: "Per-effect multiplier for periodic and vibration translation after output gain.";
                                            minimum: 0;
                                            maximum: 2;
                                            step: 0.05;
                                            value <=> root.calibration_sine_gain;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Spring Gain";
                                            subtitle: "Per-effect multiplier for spring condition translation after output gain.";
                                            minimum: 0;
                                            maximum: 2;
                                            step: 0.05;
                                            value <=> root.calibration_spring_gain;
                                        }

                                        FieldCard {
                                            title: "Damper Gain";
                                            subtitle: "Per-effect multiplier for damper condition translation after output gain.";
                                            minimum: 0;
                                            maximum: 2;
                                            step: 0.05;
                                            value <=> root.calibration_damper_gain;
                                        }
                                    }
                                }
                            }

                            if root.current_section == 5 : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 18px;

                                    Text {
                                        text: "Settings";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "Bridge launch and window behavior.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        ToggleCard {
                                            title: "Hot Reload";
                                            subtitle: "Watch saved profile changes while the bridge runs.";
                                            active: hot_reload_enabled;
                                            pressed => {
                                                root.toggle_hot_reload_requested();
                                            }
                                        }

                                        ToggleCard {
                                            title: "Close To Taskbar";
                                            subtitle: "Closing the window minimizes it instead of exiting.";
                                            active: close_to_taskbar_enabled;
                                            pressed => {
                                                root.toggle_close_to_taskbar_requested();
                                            }
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 24px;
                                        background: #121925;
                                        border-color: #1d2533;
                                        border-width: 1px;
                                        min-height: 148px;

                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 12px;

                                            Text {
                                                text: "Shutdown";
                                                color: #f6f8fb;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: "Quit the editor and stop the bridge first.";
                                                color: #7f8aa0;
                                                font-size: 13px;
                                            }

                                            HorizontalLayout {
                                                spacing: 14px;

                                                ActionButton {
                                                    width: 236px;
                                                    primary: false;
                                                    label: "Quit And Shut Down Bridge";
                                                    pressed => {
                                                        root.quit_and_shutdown_requested();
                                                    }
                                                }

                                                Rectangle { }

                                                Text {
                                                    text: bridge_running ? "Bridge running." : "Bridge stopped.";
                                                    color: #dfe7f5;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.current_section == 6 : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 18px;

                                    Text {
                                        text: "Diagnostics";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "Structured runtime events, startup snapshots, and safety resets for the current bridge session.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    Text {
                                        text: observability_source_label;
                                        color: #d9e2f2;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        StatCard {
                                            title: "RECENT EVENTS";
                                            value: diagnostics_event_count;
                                            highlighted: true;
                                        }

                                        StatCard {
                                            title: "LOG STATUS";
                                            value: diagnostics_status;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 14px;

                                        ActionButton {
                                            width: 164px;
                                            primary: false;
                                            label: "Export Session";
                                            pressed => {
                                                root.export_session_requested();
                                            }
                                        }

                                        ActionButton {
                                            width: 188px;
                                            primary: true;
                                            label: "Export Debug Bundle";
                                            pressed => {
                                                root.export_bundle_requested();
                                            }
                                        }

                                        ActionButton {
                                            width: 202px;
                                            primary: false;
                                            label: "Replay Latest Export";
                                            pressed => {
                                                root.replay_latest_session_requested();
                                            }
                                        }

                                        ActionButton {
                                            width: 152px;
                                            primary: false;
                                            label: "Return To Live";
                                            pressed => {
                                                root.return_to_live_session_requested();
                                            }
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 24px;
                                        background: #121925;
                                        border-color: #1d2533;
                                        border-width: 1px;
                                        min-height: 136px;

                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 10px;

                                            Text {
                                                text: "Log File";
                                                color: #f6f8fb;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: diagnostics_log_path;
                                                color: #d9e2f2;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                            }

                                            Text {
                                                text: diagnostics_workflow_hint;
                                                color: #7f8aa0;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 24px;
                                        background: #121925;
                                        border-color: #1d2533;
                                        border-width: 1px;
                                        min-height: 136px;

                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 10px;

                                            Text {
                                                text: "Export Locations";
                                                color: #f6f8fb;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }

                                            LineEdit {
                                                text: diagnostics_last_session_export;
                                                read-only: true;
                                            }

                                            LineEdit {
                                                text: diagnostics_last_bundle_export;
                                                read-only: true;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 24px;
                                        background: #121925;
                                        border-color: #1d2533;
                                        border-width: 1px;
                                        min-height: 420px;

                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 12px;

                                            Text {
                                                text: "Recent Events";
                                                color: #f6f8fb;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: diagnostics_events;
                                                color: #d9e2f2;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.current_section == 7 : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 18px;

                                    Text {
                                        text: "Profile Compare";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "Run a quick A/B diff against another saved profile to compare routing and force-calibration values.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    HorizontalLayout {
                                        spacing: 14px;

                                        ComboBox {
                                            model: root.compare_profile_options;
                                            current-index: root.selected_compare_profile_index < 0 ? 0 : root.selected_compare_profile_index;
                                            selected => {
                                                root.select_compare_profile_requested(self.current-index);
                                            }
                                        }

                                        ActionButton {
                                            width: 198px;
                                            primary: true;
                                            label: "Run A/B Diff";
                                            pressed => {
                                                root.run_profile_compare_requested();
                                            }
                                        }

                                        ActionButton {
                                            width: 184px;
                                            primary: false;
                                            label: compare_show_all ? "Show Changed Only" : "Show All Fields";
                                            pressed => {
                                                root.toggle_compare_show_all_requested();
                                            }
                                        }

                                        Rectangle { }
                                    }

                                    Rectangle {
                                        border-radius: 24px;
                                        background: #121925;
                                        border-color: #1d2533;
                                        border-width: 1px;
                                        min-height: 520px;

                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 12px;

                                            Text {
                                                text: "A/B Diff Report";
                                                color: #f6f8fb;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: compare_result;
                                                color: #d9e2f2;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.current_section == 8 : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 18px;

                                    Text {
                                        text: "Expirimental Effects";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "Heuristic traction-release modeling from steering and force changes. Tune per car and sim.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        ToggleCard {
                                            title: "Traction Loss Release";
                                            subtitle: "Reduce aligning/centering force when steering snap + force drop suggests grip breakaway.";
                                            active: experimental_slip_enabled;
                                            pressed => {
                                                root.experimental_slip_enabled = !root.experimental_slip_enabled;
                                            }
                                        }

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 168px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 12px;

                                                ToggleCard {
                                                    title: "Affects Constant";
                                                    subtitle: "Primary aligning torque release path.";
                                                    active: experimental_slip_apply_constant;
                                                    pressed => {
                                                        root.experimental_slip_apply_constant = !root.experimental_slip_apply_constant;
                                                    }
                                                }

                                                ToggleCard {
                                                    title: "Affects Spring";
                                                    subtitle: "Centering drop when breakaway is inferred.";
                                                    active: experimental_slip_apply_spring;
                                                    pressed => {
                                                        root.experimental_slip_apply_spring = !root.experimental_slip_apply_spring;
                                                    }
                                                }

                                                ToggleCard {
                                                    title: "Affects Damper";
                                                    subtitle: "Optional damping release during slip events.";
                                                    active: experimental_slip_apply_damper;
                                                    pressed => {
                                                        root.experimental_slip_apply_damper = !root.experimental_slip_apply_damper;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Steering Rate Threshold";
                                            subtitle: "Normalized turns-per-second trigger threshold (0-8).";
                                            minimum: 0;
                                            maximum: 8;
                                            step: 0.05;
                                            value <=> root.experimental_slip_steering_rate_threshold;
                                        }

                                        FieldCard {
                                            title: "Steering Angle Threshold";
                                            subtitle: "Normalized steering angle threshold (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_slip_steering_angle_threshold;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Force Drop Threshold";
                                            subtitle: "Minimum force-proxy drop required to trigger release (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_slip_force_drop_threshold;
                                        }

                                        FieldCard {
                                            title: "Release Strength";
                                            subtitle: "Maximum release multiplier when slip is fully active (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_slip_release_strength;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Attack (ms)";
                                            subtitle: "How quickly force gives out once triggered.";
                                            minimum: 10;
                                            maximum: 2000;
                                            step: 10;
                                            value <=> root.experimental_slip_attack_ms;
                                        }

                                        FieldCard {
                                            title: "Recovery (ms)";
                                            subtitle: "How quickly force rebuilds after slip settles.";
                                            minimum: 10;
                                            maximum: 4000;
                                            step: 10;
                                            value <=> root.experimental_slip_recovery_ms;
                                        }
                                    }

                                    FieldCard {
                                        title: "Minimum Force Floor";
                                        subtitle: "Fraction of force retained during release (0 = can fully go light).";
                                        minimum: 0;
                                        maximum: 1;
                                        step: 0.02;
                                        value <=> root.experimental_slip_min_force_floor;
                                    }

                                    Rectangle {
                                        height: 1px;
                                        background: #1d2533;
                                    }

                                    Text {
                                        text: "Inferred Dynamics Pack";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "Each effect is independently toggleable and tunable. Start low and increment strength gradually.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        ToggleCard {
                                            title: "Torque Steer";
                                            subtitle: "Directional steering-weight bias on fast steering-rate events.";
                                            active: experimental_torque_steer_enabled;
                                            pressed => {
                                                root.experimental_torque_steer_enabled = !root.experimental_torque_steer_enabled;
                                            }
                                        }

                                        ToggleCard {
                                            title: "Brake Imbalance";
                                            subtitle: "Yaw-like pull when rapid force drop occurs off-center.";
                                            active: experimental_brake_imbalance_enabled;
                                            pressed => {
                                                root.experimental_brake_imbalance_enabled = !root.experimental_brake_imbalance_enabled;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Torque Steer Strength";
                                            subtitle: "Directional constant-force bias amount (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_torque_steer_strength;
                                        }

                                        FieldCard {
                                            title: "Torque Steer Trigger";
                                            subtitle: "Steering-rate trigger threshold (0-8).";
                                            minimum: 0;
                                            maximum: 8;
                                            step: 0.05;
                                            value <=> root.experimental_torque_steer_threshold;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Brake Imbalance Strength";
                                            subtitle: "Directional pull intensity (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_brake_imbalance_strength;
                                        }

                                        FieldCard {
                                            title: "Brake Imbalance Trigger";
                                            subtitle: "Force-drop trigger threshold (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_brake_imbalance_threshold;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        ToggleCard {
                                            title: "Understeer Scrub";
                                            subtitle: "Flattens spring/damper authority when angle rises but force stays flat.";
                                            active: experimental_understeer_scrub_enabled;
                                            pressed => {
                                                root.experimental_understeer_scrub_enabled = !root.experimental_understeer_scrub_enabled;
                                            }
                                        }

                                        ToggleCard {
                                            title: "Rear Lightness";
                                            subtitle: "Transient release on fast steering reversals.";
                                            active: experimental_rear_lightness_enabled;
                                            pressed => {
                                                root.experimental_rear_lightness_enabled = !root.experimental_rear_lightness_enabled;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Understeer Strength";
                                            subtitle: "How much spring/damper force is reduced (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_understeer_scrub_strength;
                                        }

                                        FieldCard {
                                            title: "Understeer Trigger";
                                            subtitle: "Steering-angle threshold (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_understeer_scrub_threshold;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Understeer Attack (ms)";
                                            subtitle: "How quickly scrub engages.";
                                            minimum: 10;
                                            maximum: 2000;
                                            step: 10;
                                            value <=> root.experimental_understeer_scrub_attack_ms;
                                        }

                                        FieldCard {
                                            title: "Understeer Recovery (ms)";
                                            subtitle: "How quickly scrub fades.";
                                            minimum: 10;
                                            maximum: 4000;
                                            step: 10;
                                            value <=> root.experimental_understeer_scrub_recovery_ms;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Rear Lightness Strength";
                                            subtitle: "Release intensity on reversal events (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_rear_lightness_strength;
                                        }

                                        FieldCard {
                                            title: "Rear Lightness Trigger";
                                            subtitle: "Steering-rate reversal threshold (0-8).";
                                            minimum: 0;
                                            maximum: 8;
                                            step: 0.05;
                                            value <=> root.experimental_rear_lightness_threshold;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Rear Lightness Attack (ms)";
                                            subtitle: "How quickly lightness engages.";
                                            minimum: 10;
                                            maximum: 2000;
                                            step: 10;
                                            value <=> root.experimental_rear_lightness_attack_ms;
                                        }

                                        FieldCard {
                                            title: "Rear Lightness Recovery (ms)";
                                            subtitle: "How quickly lightness fades.";
                                            minimum: 10;
                                            maximum: 4000;
                                            step: 10;
                                            value <=> root.experimental_rear_lightness_recovery_ms;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        ToggleCard {
                                            title: "Curb Asymmetry";
                                            subtitle: "Directional curb-hit intensity based on wheel side and steer angle.";
                                            active: experimental_curb_asymmetry_enabled;
                                            pressed => {
                                                root.experimental_curb_asymmetry_enabled = !root.experimental_curb_asymmetry_enabled;
                                            }
                                        }

                                        ToggleCard {
                                            title: "Snap Oversteer Catch";
                                            subtitle: "Brief spring/damper rebound boost after traction release settles.";
                                            active: experimental_snap_oversteer_enabled;
                                            pressed => {
                                                root.experimental_snap_oversteer_enabled = !root.experimental_snap_oversteer_enabled;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Curb Asymmetry Strength";
                                            subtitle: "Directional periodic amplitude bias (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_curb_asymmetry_strength;
                                        }

                                        FieldCard {
                                            title: "Curb Asymmetry Trigger";
                                            subtitle: "Steering-angle threshold for asymmetry (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_curb_asymmetry_threshold;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Snap Oversteer Strength";
                                            subtitle: "Catch boost magnitude (0-1).";
                                            minimum: 0;
                                            maximum: 1;
                                            step: 0.02;
                                            value <=> root.experimental_snap_oversteer_strength;
                                        }

                                        FieldCard {
                                            title: "Snap Oversteer Trigger";
                                            subtitle: "Steering-rate trigger threshold (0-8).";
                                            minimum: 0;
                                            maximum: 8;
                                            step: 0.05;
                                            value <=> root.experimental_snap_oversteer_threshold;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        FieldCard {
                                            title: "Snap Oversteer Attack (ms)";
                                            subtitle: "How quickly catch boost appears.";
                                            minimum: 10;
                                            maximum: 2000;
                                            step: 10;
                                            value <=> root.experimental_snap_oversteer_attack_ms;
                                        }

                                        FieldCard {
                                            title: "Snap Oversteer Recovery (ms)";
                                            subtitle: "How quickly catch boost decays.";
                                            minimum: 10;
                                            maximum: 4000;
                                            step: 10;
                                            value <=> root.experimental_snap_oversteer_recovery_ms;
                                        }
                                    }
                                }
                            }

                            if root.current_section == 9 : Rectangle {
                                background: transparent;

                                VerticalLayout {
                                    spacing: 18px;

                                    Text {
                                        text: "Telemetry";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "Live bridge snapshots built from the same session log as diagnostics, but focused on current state instead of the full event tail.";
                                        color: #7f8aa0;
                                        font-size: 14px;
                                    }

                                    Text {
                                        text: observability_source_label;
                                        color: #d9e2f2;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        StatCard {
                                            title: "UPTIME";
                                            value: telemetry_uptime;
                                            highlighted: true;
                                        }

                                        StatCard {
                                            title: "PACKET RATE";
                                            value: telemetry_packet_rate;
                                        }

                                        StatCard {
                                            title: "COMMAND RATE";
                                            value: telemetry_command_rate;
                                        }

                                        StatCard {
                                            title: "STEERING";
                                            value: telemetry_steering;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        StatCard {
                                            title: "CAL PROFILE";
                                            value: telemetry_calibration_profile;
                                        }

                                        StatCard {
                                            title: "CAL GAIN";
                                            value: telemetry_calibration_gain;
                                            highlighted: true;
                                        }

                                        StatCard {
                                            title: "FILTER COEFF";
                                            value: telemetry_filter_coefficient;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        StatCard {
                                            title: "PEAK FORCE";
                                            value: telemetry_peak_force;
                                            highlighted: true;
                                        }

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 112px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 10px;

                                                Text {
                                                    text: "Clamp Status";
                                                    color: #f6f8fb;
                                                    font-size: 17px;
                                                    font-weight: 700;
                                                }

                                                Text {
                                                    text: telemetry_clamp_status;
                                                    color: #d9e2f2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 112px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 10px;

                                                Text {
                                                    text: "Condition Saturation";
                                                    color: #f6f8fb;
                                                    font-size: 17px;
                                                    font-weight: 700;
                                                }

                                                Text {
                                                    text: telemetry_saturation_status;
                                                    color: #d9e2f2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 132px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 10px;

                                                Text {
                                                    text: "Packet Trend";
                                                    color: #f6f8fb;
                                                    font-size: 17px;
                                                    font-weight: 700;
                                                }

                                                Text {
                                                    text: telemetry_packet_trend;
                                                    color: #d9e2f2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 132px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 10px;

                                                Text {
                                                    text: "Command Trend";
                                                    color: #f6f8fb;
                                                    font-size: 17px;
                                                    font-weight: 700;
                                                }

                                                Text {
                                                    text: telemetry_command_trend;
                                                    color: #d9e2f2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 132px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 10px;

                                                Text {
                                                    text: "Force Trend";
                                                    color: #f6f8fb;
                                                    font-size: 17px;
                                                    font-weight: 700;
                                                }

                                                Text {
                                                    text: telemetry_force_trend;
                                                    color: #d9e2f2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 24px;
                                        background: #121925;
                                        border-color: #1d2533;
                                        border-width: 1px;
                                        min-height: 112px;

                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 10px;

                                            Text {
                                                text: "Snapshot Status";
                                                color: #f6f8fb;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: telemetry_status;
                                                color: #d9e2f2;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 18px;

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 214px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 12px;

                                                Text {
                                                    text: "Runtime Context";
                                                    color: #f6f8fb;
                                                    font-size: 17px;
                                                    font-weight: 700;
                                                }

                                                Text {
                                                    text: telemetry_runtime_detail;
                                                    color: #d9e2f2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            border-radius: 24px;
                                            background: #121925;
                                            border-color: #1d2533;
                                            border-width: 1px;
                                            min-height: 214px;

                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 12px;

                                                Text {
                                                    text: "Last Translation";
                                                    color: #f6f8fb;
                                                    font-size: 17px;
                                                    font-weight: 700;
                                                }

                                                Text {
                                                    text: telemetry_last_update;
                                                    color: #d9e2f2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 24px;
                                        background: #121925;
                                        border-color: #1d2533;
                                        border-width: 1px;
                                        min-height: 180px;

                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 12px;

                                            Text {
                                                text: "Last Applied Commands";
                                                color: #f6f8fb;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: telemetry_last_commands;
                                                color: #d9e2f2;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}